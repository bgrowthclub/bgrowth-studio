VITE_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# BGrowth Identity for Studio — same Supabase project bgrowth-portal uses.
# VITE_-prefixed vars are the anon-key browser client (src/lib/supabaseClient.ts);
# the unprefixed pair is the service-role client used only by Studio's
# serverless functions (api/_lib/supabaseAdmin.js) to verify sessions and
# check the content_engine.admins allowlist server-side. Never expose the
# service role key to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BGrowth Content Engine — the Portal's public site origin, used only to
# build the UTM-tagged link an admin copies into a social post
# (src/modules/content-engine/utmLink.ts). Not a secret — the same origin
# customers already browse to.
VITE_PORTAL_BASE_URL=https://your-portal-deployment.vercel.app

# api/publish.js only — server-side, never exposed to the browser. The
# BGrowth Publishing Engine endpoint lives in bgrowth-portal; this is how
# Studio's serverless proxy reaches it without the secret ever touching
# client code. Do NOT prefix these with VITE_.
PORTAL_PUBLISHING_ENGINE_URL=https://your-portal-deployment.vercel.app/api/publishing-engine/publish
PORTAL_PUBLISHING_ENGINE_SECRET=a-long-random-shared-secret
